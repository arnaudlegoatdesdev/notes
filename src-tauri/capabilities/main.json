{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Acc\u00e8s minimal pour la fen\u00eatre locale de Notes.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-hide",
