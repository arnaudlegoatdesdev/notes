{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flion",
  "version": "0.1.0",
  "identifier": "fr.flion.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flion",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://www.googleapis.com https://*.googleapis.com https://graph.microsoft.com https://*.1drv.com https://*.sharepoint.com; object-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "shortDescription": "Votre espace personnel chiffré",
    "longDescription": "Des salons, des mémos et des fichiers sur votre cloud personnel.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}